#define ZMK_POINTING_DEFAULT_SCRL_VAL 5
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        comb1 {
            bindings = <&kp TAB>;
            key-positions = <11 10>;
        };

        comb2 {
            bindings = <&kp LS(ESCAPE)>;
            key-positions = <0 1>;
        };

        comb3 {
            bindings = <&kp CAPSLOCK>;
            key-positions = <22 23>;
        };

        comb4 {
            bindings = <&kp BACKSPACE>;
            key-positions = <9 8>;
        };

        comb5 {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <9 8>;
            timeout-ms = <0>;
            layers = <2>;
        };

        MS_BTN1_ {
            bindings = <&mkp MB1>;
            key-positions = <38 39>;
        };

        MS_BTN2_ {
            bindings = <&mkp MB2>;
            key-positions = <38 37>;
        };

        Lclick {
            bindings = <&mkp MB1>;
            key-positions = <18 19>;
        };

        Rclick {
            bindings = <&mkp MB2>;
            key-positions = <30 31>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        prof0_sw: prof0_sw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
        };

        prof1_sw: prof1_sw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 6>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    // エンコーダー：キー

    rot_kp: sensor_rotate_kp {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        bindings = <&kp>, <&kp>;
    };

    // エンコーダー：マウススクロール 

    rot_msc: sensor_rotate_msc {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        tap-ms = <20>;
        bindings = <&msc>, <&msc>;
    };

    // エンコーダー：マウススクロール(MOVE_Y)

    scroll_move_y: sensor_rotate_msc_for_move_y {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc MOVE_Y(20)>, <&msc MOVE_Y(-20)>;

        // tap-ms下限メモ Yの値で可変: Y(15) <81>, Y(20) <65>, Y(25) <49>

        tap-ms = <65>;
    };

    // エンコーダー：マウススクロール(MOVE_X)

    scroll_move_x: sensor_rotate_msc_for_move_x {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc MOVE_X(20)>, <&msc MOVE_X(-20)>;

        // tap-ms下限メモ Xの値で可変: X(15) <81>, X(20) <65>, X(25) <49>

        tap-ms = <65>;
    };

    keymap {
        compatible = "zmk,keymap";

        Mac_default {
            bindings = <
&lt 3 TAB  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &lt 4 P
&lt 3 A  &kp S  &kp D  &kp F  &kp G  &kp LANG1    &kp MINUS  &kp H  &kp J  &kp K  &lt 3 L  &lt 4 BACKSPACE
&kp Z  &kp X  &kp C  &lt 5 V  &kp B  &lt 9 LEFT_PARENTHESIS    &lt 9 BACKSLASH  &kp N  &kp M  &kp COMMA  &kp PERIOD  &mt LEFT_SHIFT DELETE
&mt LEFT_SHIFT Q  &kp LEFT_ALT  &lt 3 F2  &kp LEFT_GUI  &mt LEFT_COMMAND ESCAPE  &lt 2 SPACE    &lt 4 ENTER  &kp BACKSPACE  &mt LCTRL SLASH
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB1  &trans  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mo 7    &lt 9 SPACE  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        Mac_control {
            bindings = <
&kp LC(UP_ARROW)  &kp LC(LEFT)  &kp UP_ARROW  &kp LC(RIGHT)  &kp LANGUAGE_2    &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS  &kp KP_MINUS
&kp LA(LG(LEFT))  &kp LA(LEFT)  &kp DOWN  &kp LA(RIGHT)  &kp LA(LG(RIGHT))  &trans    &trans  &kp KP_N4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MULTIPLY  &kp SLASH
&kp LS(LC(A))  &kp LS(LG(LA(V)))  &kp LG(C)  &kp LG(V)  &kp LG(Q)  &kp LC(LA(SPACE))    &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL  &kp CARET
&kp LS(LC(E))  &kp LEFT_WIN  &kp LC(LS(TAB))  &kp LALT  &kp LC(TAB)  &kp LC(LS(TAB))    &kp BACKSPACE  &kp KP_N0  &kp PERCENT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        Mac_arrows {
            bindings = <
&trans  &kp AT_SIGN  &kp LC(E)  &kp LANGUAGE_1  &kp DOLLAR    &kp AMPERSAND  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS  &kp UP_ARROW
&kp LC(HOME)  &kp LC(HOME)  &kp BACKSPACE  &kp RIGHT  &trans  &trans    &trans  &kp AT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON  &kp COLON
&kp LEFT_SHIFT  &trans  &trans  &kp LG(LS(V))  &kp LEFT  &trans    &trans  &kp DOWN  &kp SINGLE_QUOTE  &kp EXCLAMATION  &kp LS(SLASH)  &kp UNDER
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans    &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp INT_YEN
            >;
        };

        Mac_FUNCTION {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &to 0    &kp INT_MUHENKAN  &kp AMPERSAND  &kp SQT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp ENTER
&kp PLUS  &kp MINUS  &kp ASTERISK  &kp F11  &kp F12  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp TILDE  &kp QUESTION  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp QUESTION
&none  &none  &none  &none  &none  &none    &kp MINUS  &kp DEL  &kp LEFT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        ARROW {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &kp N1    &kp N2  &kp H  &mkp MB1  &kp K  &mkp MB2  &kp ENTER
&kp Z  &kp X  &kp C  &kp V  &kp B  &kp N3    &kp N4  &kp N  &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&kp RSHIFT  &kp LCTRL  &kp LGUI  &kp LALT  &lt 4 SPACE  &kp N5    &kp N6  &lt 9 SPACE  &kp BSPC
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        Win_default {
            bindings = <
&lt 8 TAB  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &lt 5 P
&lt 8 A  &kp S  &kp D  &kp F  &kp G  &kp GRAVE    &kp ESC  &kp H  &kp J  &kp K  &lt 8 L  &lt 2 BSPC
&kp Z  &kp X  &kp C  &lt 1 V  &kp B  &lt 9 BSLH    &kp LALT  &kp N  &kp M  &kp CMMA  &kp PERIOD  &mt RSFT DEL
&mt LSFT Q  &kp LALT  &lt 8 F2  &kp LGUI  &mt LCTL ESC  &lt 7 SPC    &lt 1 RET  &kp BSPC  &lt 6 FSLH
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        win_control {
            bindings = <
&kp LG(TAB)  &kp LG(LC(LEFT))  &kp UP_ARROW  &kp LG(LC(RARW))  &kp LANGUAGE_2    &kp KP_NUMBER_7  &kp KP_N8  &kp KP_N9  &kp KPLS  &kp MINUS
&kp LA(LEFT)  &kp LC(PG_UP)  &kp DOWN  &kp LC(PG_DN)  &kp LA(RIGHT)  &trans    &trans  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KMLT  &kp FSLH
&kp LS(HOME)  &kp LC(LS(V))  &kp LC(C)  &kp LC(V)  &kp LA(F4)  &trans    &trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp UNDER  &kp EQL
&kp LS(END)  &kp LS(LC(A))  &kp LC(LS(TAB))  &kp LALT  &kp LC(TAB)  &kp LC(LS(TAB))    &kp ENTER  &kp KP_N0  &kp PRCT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        win_arrows {
            bindings = <
&trans  &kp AT_SIGN  &kp END  &kp LANGUAGE_1  &kp DOLLAR    &kp CRRT  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp MINUS  &kp UP_ARROW
&kp HOME  &kp HOME  &kp BACKSPACE  &kp RIGHT  &trans  &trans    &trans  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &kp PG_UP  &trans  &kp LG(V)  &kp LEFT  &trans    &trans  &kp DOWN  &kp AMPERSAND  &kp EXCLAMATION  &kp LS(SLASH)  &kp LS(INTERNATIONAL_1)
&trans  &kp PG_DN  &trans  &trans  &trans  &trans    &kp LS(RIGHT_BRACKET)  &kp PIPE  &kp INTERNATIONAL_3
            >;
        };

        NUM {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&bt BT_SEL 0  &prof1_sw  &kp DOUBLE_QUOTES  &kp SEMICOLON  &kp COLON  &mo 4    &kp INT_KATAKANAHIRAGANA  &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp ENTER
&kp Z  &kp X  &kp C  &kp V  &kp B  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp LC(SPACE)  &kp RG(SPACE)  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp SLASH
&prof0_sw  &prof1_sw  &bt BT_CLR_ALL  &studio_unlock  &kp LEFT_ALT  &kp UNDERSCORE    &none  &bt BT_CLR_ALL  &kp LEFT_SHIFT
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };
    };
};

&mmv {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <100>;
    trigger-period-ms = <5>;
    delay-ms = <20>;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <100>;
    trigger-period-ms = <3>;
    delay-ms = <3>;
};
